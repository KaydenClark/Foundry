{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "Edit(./node_modules/**)",
      "Write(./node_modules/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Edit(./src/**)",
      "Edit(./bin/**)",
      "Edit(./test/**)",
      "Edit(./tools/**)",
      "Edit(./specs/**)",
      "Edit(./AGENTS.md)",
      "Edit(./BLUEPRINT.md)",
      "Edit(./LEXICON.md)",
      "Edit(./TASKBOARD.md)",
      "Edit(./RUNBOOK.md)",
      "Edit(./README.md)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run test:audit:*)",
      "Bash(node tools/spec-workbench.mjs:*)"
    ]
  }
}
