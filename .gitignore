# Installed Modules keep their own Git histories. The four native Halls under
# Halls/ are ordinary tracked source and
# are deliberately not listed here.
/Modules/

# Registered component worktrees and all deployment-local state are untracked.
/.worktrees/
/.local/
/.foundry/

# Secrets, runtime output, and editor/OS noise never belong in the harness.
.env
.env.*
!.env.example
*.log
.DS_Store
node_modules/
coverage/
dist/
