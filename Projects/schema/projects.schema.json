{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schema/projects.schema.json",
  "title": "Foundry Projects Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^P-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^Projects/[^/].*" }
        }
      }
    }
  }
}
